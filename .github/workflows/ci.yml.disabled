# CI for the AI Software Development Factory (T087).
# Runs lint (ruff) plus unit/contract tests with the network guard, then the
# opt-in integration tests (deterministic, fake sandbox/git host, no container).
#
# Hermeticity: deterministic jobs never touch the real network or a container
# runtime. The `researcher` real-network `web` path is marked `live` and runs
# only in the separate opt-in `live` job (on-demand), never in deterministic CI.
name: CI

on:
  push:
  pull_request:
  # Allow running the real-network researcher `web` path on demand via the UI.
  workflow_dispatch:
    inputs:
      run_live:
        description: "Run real-network `live` tests (researcher web path)"
        type: boolean
        default: false

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: Install uv
        uses: astral-sh/setup-uv@v7
      - name: Set up Python 3.14
        uses: actions/setup-python@v7
        with:
          python-version: "3.14"
      - name: Install dependencies
        run: uv sync --all-extras --dev
      - name: Lint (ruff)
        run: uv run ruff check .

  test:
    runs-on: ubuntu-latest
    needs: lint
    strategy:
      matrix:
        python-version: ["3.14"]
    steps:
      - uses: actions/checkout@v7
      - name: Install uv
        uses: astral-sh/setup-uv@v7
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v7
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: uv sync --all-extras --dev
      - name: Unit + contract tests (network blocked)
        run: uv run pytest -m "not integration"

  integration:
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@v7
      - name: Install uv
        uses: astral-sh/setup-uv@v7
      - name: Set up Python 3.14
        uses: actions/setup-python@v7
        with:
          python-version: "3.14"
      - name: Install dependencies
        run: uv sync --all-extras --dev
      # Hermetic end-to-end with deterministic fake sandbox/git host. The
      # `live` real-network researcher web path is excluded (best-effort only).
      - name: Integration tests (deterministic, container-free)
        run: uv run pytest -m "integration and not live"

  # Real-network `live` job: the researcher `web` path hits external hosts
  # (best-effort, inherently flaky). Runs only on workflow_dispatch when asked,
  # never on every push/PR, so deterministic CI stays hermetic and trustworthy.
  live:
    runs-on: ubuntu-latest
    needs: lint
    if: ${{ github.event_name == 'workflow_dispatch' && inputs.run_live }}
    steps:
      - uses: actions/checkout@v7
      - name: Install uv
        uses: astral-sh/setup-uv@v7
      - name: Set up Python 3.14
        uses: actions/setup-python@v7
        with:
          python-version: "3.14"
      - name: Install dependencies
        run: uv sync --all-extras --dev
      - name: Live real-network tests (researcher web path, best-effort)
        run: uv run pytest -m live
