# Agent-crew environment template.
# Copy to `.env` and fill in real values locally. `.env` is gitignored;
# this file (`.env.example`) is tracked and must never contain real secrets.

# --- LangSmith (OPT-IN observability) ---
# Requires network + an API key. Leave unset for the offline/zero-credential
# default. See docs/langsmith.md.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-crew

# --- LLM-backed nodes (opt-in) ---
# One of the two providers below is required to call the LLM node.
# Supported providers: openrouter | opencode (OpenCode Go).
#
# OpenRouter: aggregated gateway. Key at https://openrouter.ai (starts sk-or-v1...)
OPENROUTER_API_KEY=
# Model IDs use the <author>/<slug> form and must match the official slug exactly
# (no `-latest` suffix); `~<author>/<slug>-latest` is the auto-updating alias.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
#
# OpenCode Go: $10/mo subscription for open-source coding models (opencode.ai/zen/go).
# Key from OpenCode Zen. OpenAI-compatible endpoint /v1/chat/completions.
OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODEL=deepseek-v4-flash